# 서버 (apps/server)
SERVER_PORT=3190
# 세션 쿠키 서명, 가명 ID 만들기에 쓰는 비밀 값. 실제 값은 .env에만 두고 저장소에 올리지 않아요.
SESSION_SECRET=change-me-session-secret-at-least-32-chars
PSEUDONYM_SECRET=change-me-pseudonym-secret-at-least-32-chars
PROPOSAL_SECRET=change-me-proposal-secret-at-least-32-chars
MCP_TOKEN_SECRET=change-me-mcp-token-secret-at-least-32-chars
# 비워 두면 내장 PGlite(.data/pglite)를 써요. 아래는 npm run db:up 으로 띄운 로컬 PostgreSQL 주소예요.
DATABASE_URL=postgres://desk:desk@localhost:5433/one_line_desk
# 시험 DB(TEST_DATABASE_URL)는 여기에 넣어도 시험이 보지 않아요. npm run test:pg가 넣거나, 시험을 시작하는 셸에 넣어요.
# 회사 명의 무보관 계약이 확인됐는지. false면 AI 게이트웨이는 등급 0만 통과시켜요(R6).
NO_RETENTION_CONTRACT_CONFIRMED=false
# AI 공급자. 비우면 모델을 부르지 않는 fake(규칙·틀 문장)예요. anthropic이면 운영은 ANTHROPIC_API_KEY가 꼭 있어야 떠요.
# DESK_AI_PROVIDER=anthropic
# DESK_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# 사내 AI 관문을 거칠 때만(https).
# ANTHROPIC_BASE_URL=https://ai-gateway.corp.example
# 로그인·직원 명단. 비우면 앱 안 모의 직원, keycloak이면 임시 IdP(npm run idp:up)예요. 운영에서는 회사 IdP 주소·비밀 값을 넣어요.
# DESK_IDP=keycloak
# DESK_IDP_ISSUER=http://localhost:8180/realms/one-line-desk
# DESK_IDP_CLIENT_ID=one-line-desk-web
# DESK_IDP_DIRECTORY_CLIENT_ID=one-line-desk-directory
# DESK_IDP_CLIENT_SECRET=...
# DESK_IDP_DIRECTORY_CLIENT_SECRET=...
# 넣으면 회의 초대 Slack DM을 실제로 보내요(봇 권한 users:read.email·im:write·chat:write). Slack 보관 조건·보안 승인 뒤에만 넣어요.
# SLACK_BOT_TOKEN=

# ── 운영(NODE_ENV=production) ──
# 운영은 이 .env 파일을 읽지 않아요. 아래 값은 모두 배포가 프로세스 환경으로 넣어요(비밀은 사내 비밀 저장소에서).
# 운영은 같은 서버가 웹 화면 파일(apps/web/dist)도 줘요. 다른 폴더면 DESK_WEB_DIST로 알려 줘요. 없으면 뜨지 않아요.
# DESK_WEB_DIST=/app/apps/web/dist
# 웹 화면을 다른 곳(Vercel 시연)이 주고 이 서버는 API만 받으면 none이에요(화면 파일 없이도 떠요).
# DESK_WEB_DIST=none
# 운영은 값 하나만 빠지거나 개발용 값(dev-only·change-me, 32자 미만, 서로 같은 비밀)이어도 이유를 모두 말하고 뜨지 않아요(L-15).
# 꼭 넣어요: PUBLIC_BASE_URL(https), 비밀 값 넷, DATABASE_URL, TRUST_PROXY, DESK_IDP=keycloak + DESK_IDP_ISSUER(https)·두 비밀 값. ANTHROPIC_LOG는 넣지 않아요.
# PUBLIC_BASE_URL=https://desk.example.com
# 시연 배포만 모의 로그인·가상 자료·모의 그룹웨어/Slack·시연 MCP 클라이언트를 열어요(그때는 IdP·PostgreSQL 없이도 떠요).
# DESK_MOCK_LOGIN=true
# 시연을 정한 명단(15명 안쪽) 밖으로 넓힐 때만: 문의를 저장하지 않고, 운영 설정을 바꾸지 못하게 해요(누구나 가상 운영자로 들어와서요).
# DESK_DEMO_WIDE=true
# 시연 비밀번호(12자 이상). 넣으면 모의 로그인에 이 비밀번호가 있어야 들어와요. 웹 화면을 공개 주소(Vercel)에 올린 시연은 꼭 넣어요. 운영 배포에는 넣으면 뜨지 않아요.
# DESK_DEMO_PASSWORD=
# 가상 자료 넣기. 개발·시연은 기본 켬, 운영은 넣으면 뜨지 않아요.
# DESK_SEED_DEMO=false
# 서버가 뜰 때 마이그레이션 적용. 개발·시연은 기본 켬, 운영은 기본 끔이라 배포 잡이 npm run db:migrate를 먼저 돌려요(L-22).
# DESK_MIGRATE_ON_START=false
# 듣는 주소(운영 기본 0.0.0.0, 개발 localhost)와 믿을 앞단 프록시.
# TRUST_PROXY에는 관문(리버스 프록시) 주소만 넣어요. 운영(시연 아님)은 꼭 넣고, 관문 없이 직접 받으면 none을 넣어요.
# true·숫자·이름 대역·/24(IPv6 /64)보다 넓은 대역(10.0.0.0/8 등)은 위조한 접속 IP를 믿게 돼서 운영에서 뜨지 않아요.
# 접속기록(ADR-20)의 접속지가 이 값으로 정해지고, 관문은 X-Forwarded-For를 덮어써야 해요.
# HOST=0.0.0.0
# TRUST_PROXY=10.0.3.11
# 시연 배포가 DB를 쓸 때만: 시연 전용 DB라는 표시(운영 DB에 시연 깃발이 섞이지 않게, ADR-20).
# DESK_DEMO_DATABASE=true

# ── 사내 프록시·사내 인증서(사내망에서 바깥으로 나갈 때) ──
# HTTPS_PROXY만 넣으면 Node가 조용히 무시해요. NODE_USE_ENV_PROXY=1을 같이 넣어요(Node 22.21 또는 24.0 이상).
# NO_PROXY에는 호스트 이름만 넣어요(10.0.0.0/8 같은 대역 표기는 무시돼요).
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.corp.example:8080
# NO_PROXY=localhost,idp.corp.example
# 사내 인증 기관으로 서명한 IdP·프록시를 믿을 때. NODE_TLS_REJECT_UNAUTHORIZED=0은 쓰지 않아요(운영에서 뜨지 않아요).
# NODE_EXTRA_CA_CERTS=/etc/ssl/corp-root.pem

# ── 회사 로그인 MFA 근거(ADR-20) ──
# off(기본) = MFA는 IdP 조건부 접근·접속 프록시가 맡아요. always = ID 토큰에 MFA 근거가 없으면 세션을 만들지 않아요.
# DESK_REQUIRE_MFA=off
# MFA로 볼 amr 값(쉼표). 기본 mfa,otp,hwk,swk. SMS·전화는 넣지 않아요(정보보안팀).
# DESK_IDP_MFA_AMR=mfa,otp,hwk,swk
# MFA로 볼 acr 값(쉼표, IdP마다 달라요)과 로그인 요청에 넣을 acr_values(선택).
# DESK_IDP_MFA_ACR=
# DESK_IDP_ACR_VALUES=
