{
  "name": "one-line-desk",
  "private": true,
  "description": "한 줄 데스크: 회의실·공지 + 같이 채워요 + 담당자 내비를 합친 사내 안내 데스크",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.21.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @one-line-desk/server\" \"npm run dev -w @one-line-desk/web\"",
    "build": "npm run build -w @one-line-desk/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "db:up": "docker compose up -d db",
    "db:test:up": "docker compose up -d --wait db-test",
    "db:test:down": "docker compose stop db-test",
    "test:pg": "node scripts/test-pg.mjs",
    "idp:up": "docker compose up -d idp",
    "dev:idp": "node scripts/dev-idp.mjs",
    "idp:down": "docker compose stop idp",
    "db:migrate": "npm run db:migrate -w @one-line-desk/server",
    "tenant": "node --import tsx apps/server/scripts/tenant.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
